# Leave unset for local development — requests fall back to '/api' and are
# proxied to the backend by Vite (see vite.config.js).
#
# For production (e.g. Vercel), set this to your deployed backend's full URL,
# including the /api suffix, e.g.:
# VITE_API_BASE_URL=https://greenbin-ai-backend.onrender.com/api
VITE_API_BASE_URL=
